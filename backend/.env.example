# ===================== STI-GA backend — variables de entorno =====================
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

APP_NAME="STI-GA API"
APP_ENV=development            # development | test | staging | production
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Orígenes permitidos para CORS (separados por coma). El frontend de Vite usa 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de datos -----------------------------------------------------------
# PostgreSQL local (docker compose): 
DATABASE_URL=postgresql+psycopg://sti_app:sti_app_dev_password@localhost:5432/sti_dev
# Supabase (pooler en modo transacción, puerto 6543) — usa la cadena que te da Supabase, con el driver psycopg:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Conexión directa para migraciones (puerto 5432):
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false
# true cuando DATABASE_URL apunta a un pooler en modo transacción (PgBouncer/Supavisor)
DATABASE_USES_TRANSACTION_POOLER=false

# --- Seguridad (Fase 2 usa estos valores; ya se validan desde la Fase 1) ------
# Genera un secreto de al menos 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ISSUER=sti-ga
JWT_AUDIENCE=sti-ga-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Roles que pueden usar la recuperación de contraseña por correo
PASSWORD_RESET_ROLES=ADMIN,TEACHER,RESEARCHER,STUDENT
RATE_LIMIT_AUTH="10/minute"

# --- Documentos legales vigentes (versión mostrada en el registro) -------------
PRIVACY_POLICY_VERSION=2026.1
TERMS_VERSION=2026.1

# --- IA opcional (Fase 7). Con LLM_ENABLED=false la plataforma es completa sin IA.
LLM_ENABLED=false
LLM_PROVIDER=null              # null | anthropic | openai_compatible
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=8000
LLM_MAX_CALLS_PER_SESSION=20

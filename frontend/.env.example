# Variables públicas del frontend (todo VITE_* se incluye en el bundle: NUNCA secretos).
# URL base de la API. En desarrollo puede dejarse vacía para usar el proxy de Vite (/api → http://localhost:8000).
VITE_API_BASE_URL=
# Destino del proxy de desarrollo (solo lo usa vite.config.ts).
VITE_DEV_PROXY_TARGET=http://localhost:8000
# Nombre visible de la plataforma.
VITE_APP_NAME=STI-GA
